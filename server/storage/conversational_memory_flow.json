{
  "id": "conversational_memory_flow",
  "name": "Multi-Turn Memory Chatbot",
  "description": "Multi-turn conversational chatbot with SQLite persistent memory and sliding window context recall.",
  "nodes": [
    {
      "id": "node_input",
      "type": "input",
      "title": "User Query Input",
      "position": { "x": 60, "y": 200 },
      "data": {
        "title": "User Query Input",
        "config": {
          "default_query": "Xin chào! Bạn có thể ghi nhớ thông tin trong suốt cuộc trò chuyện không?"
        }
      }
    },
    {
      "id": "node_memory",
      "type": "memory",
      "title": "Conversation Memory",
      "position": { "x": 380, "y": 200 },
      "data": {
        "title": "Conversation Memory",
        "config": {
          "strategy": "sliding_window",
          "window_size": 6,
          "max_token_budget": 2048,
          "storage_backend": "sqlite_persistent",
          "human_prefix": "User",
          "ai_prefix": "Assistant"
        }
      }
    },
    {
      "id": "node_prompt",
      "type": "prompt",
      "title": "Prompt Template",
      "position": { "x": 720, "y": 180 },
      "data": {
        "title": "Prompt Template",
        "config": {
          "system_template": "Bạn là trợ lý AI thông minh có khả năng ghi nhớ toàn bộ ngữ cảnh hội thoại đa lượt qua ZFlow SQLite Store.",
          "user_template": "Ngữ cảnh lịch sử trò chuyện trước đó:\n{formatted_history}\n\nCâu hỏi mới nhất từ người dùng:\n{query}"
        }
      }
    },
    {
      "id": "node_llm",
      "type": "llm",
      "title": "LLM Inference Engine",
      "position": { "x": 1060, "y": 180 },
      "data": {
        "title": "LLM Inference Engine",
        "config": {
          "provider": "simulator",
          "model": "gpt-4o-mini",
          "temperature": 0.7,
          "max_tokens": 1024
        }
      }
    },
    {
      "id": "node_output",
      "type": "output",
      "title": "Chatbot Response",
      "position": { "x": 1400, "y": 200 },
      "data": {
        "title": "Chatbot Response",
        "config": {
          "prefix": "",
          "suffix": ""
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-input-memory",
      "source": "node_input",
      "target": "node_memory",
      "sourceHandle": "session_id",
      "targetHandle": "session_id"
    },
    {
      "id": "edge-memory-prompt",
      "source": "node_memory",
      "target": "node_prompt",
      "sourceHandle": "formatted_history",
      "targetHandle": "context_data"
    },
    {
      "id": "edge-prompt-llm",
      "source": "node_prompt",
      "target": "node_llm",
      "sourceHandle": "prompt",
      "targetHandle": "prompt"
    },
    {
      "id": "edge-llm-output",
      "source": "node_llm",
      "target": "node_output",
      "sourceHandle": "text",
      "targetHandle": "response_text"
    }
  ]
}
